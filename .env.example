# Copy to `.env` and fill in. `.env` is gitignored; never commit it.
# `core.config` loads a repo-root `.env` at import (python-dotenv); a variable already exported in your shell wins.

# ---- Judges + Claude targets --------------------------------------------------------------------------
# Every judge (the banking judge, the concealment judge, the memory auditor, the evaluation-awareness judge)
# runs on claude-opus-4-8, and the Claude targets (haiku, sonnet-5, opus-5, fable-5) use the same key.
# If unset the harness falls back to ANTHROPIC_API_KEY, the SDK's own name for the same key.
CLAUDE_API_KEY=

# ---- Needed only for the targets that use them ----------------------------------------------------------
# gpt-5.6, gpt-5-mini
OPENAI_API_KEY=
# gemini-3.1-pro, gemini-3.6-flash
GEMINI_API_KEY=
# deepseek-v4, mistral-medium, kimi-k3
OPENROUTER_API_KEY=

# ---- Non-secret tuning knobs ----------------------------------------------------------------------------
MODEL_RETRY_ATTEMPTS=8
MODEL_RETRY_MAX_SECONDS=1200
